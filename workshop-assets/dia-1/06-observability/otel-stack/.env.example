# Plantilla de referencia: setup-observability.sh genera otel-stack/.env
# automáticamente en la primera ejecución (contraseña aleatoria, chmod 600).
# Solo si quieres definirlas a mano: cp .env.example .env && chmod 600 .env
# Credenciales del usuario root de OpenObserve; el Collector usa las mismas para
# la ingesta OTLP. La contraseña debe tener al menos 8 caracteres.
ZO_ROOT_USER_EMAIL=admin@kong.com
ZO_ROOT_USER_PASSWORD=
