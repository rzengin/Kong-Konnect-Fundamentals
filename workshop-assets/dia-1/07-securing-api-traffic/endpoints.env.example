# Plantilla de endpoints de los Control Planes (External / Internal) de Konnect.
# El archivo real (endpoints.env) NO se versiona: lo genera
#   python3 scripts/generate_certs.py   (requiere KONNECT_TOKEN de kong-env)
# Valores sin "https://".
export EXTERNAL_TELEMETRY=<id>.us.tp0.konghq.com
export EXTERNAL_CONTROL=<id>.us.cp0.konghq.com
export INTERNAL_TELEMETRY=<id>.us.tp0.konghq.com
export INTERNAL_CONTROL=<id>.us.cp0.konghq.com
