# Plantilla de endpoints del Control Plane de Konnect.
# El archivo real (endpoints.env) NO se versiona: lo genera
#   python3 scripts/generate_certs.py   (requiere KONNECT_TOKEN y DEMO_PREFIX de kong-env)
# Valores sin "https://", tal como los devuelve la API de Konnect.
export TELEMETRY_ENDPOINT=<id>.us.tp0.konghq.com
export CONTROL_PLANE_ENDPOINT=<id>.us.cp0.konghq.com
